# ==============================================================================
# BYTEFORGE OMNI-COMMERCE - ROOT ENVIRONMENT TEMPLATE
# ==============================================================================

# API Backend Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/byteforge_omnicommerce?schema=public"

# Authentication & Encryption
JWT_SECRET="replace-with-a-secure-random-64-char-string-in-production"
JWT_EXPIRES_IN="7d"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Frontend Origin
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:5000/api/v1"

# Shopify Partner / App Configuration
SHOPIFY_API_VERSION="2025-01"
SHOPIFY_API_KEY="placeholder_shopify_api_key_from_partner_dashboard"
SHOPIFY_API_SECRET="placeholder_shopify_api_secret_from_partner_dashboard"
SHOPIFY_WEBHOOK_SECRET="placeholder_shopify_webhook_secret_for_hmac"
SHOPIFY_SCOPES="read_orders,write_orders,read_customers"
SHOPIFY_APP_URL="http://localhost:5000"

# Meta WhatsApp Cloud API Configuration
META_APP_ID="placeholder_meta_app_id_from_developers_portal"
META_APP_SECRET="placeholder_meta_app_secret_for_x_hub_signature"
META_WEBHOOK_VERIFY_TOKEN="byteforge_meta_verify_token_change_in_production"
META_GRAPH_API_VERSION="v21.0"
META_API_VERSION="v21.0"
